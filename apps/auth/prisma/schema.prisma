generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

model User {
    id            String         @id @default(uuid())
    email         String         @unique
    username      String         @unique
    password      String
    createdAt     DateTime       @default(now())
    refreshTokens RefreshToken[]
}

model RefreshToken {
    id        String   @id @default(uuid())
    token     String   @unique
    userId    String
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    expiresAt DateTime
}
