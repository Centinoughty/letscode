generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Code {
  id        String   @id @default(uuid())
  name      String
  language  String
  source    String
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  collaborators CodeCollaborator[]
}

model CodeCollaborator {
  id         String   @id @default(uuid())
  codeId     String
  userId     String
  permission String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  code Code @relation(fields: [codeId], references: [id])

  @@unique([codeId, userId])
}
